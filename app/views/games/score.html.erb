<div class="container w-50">
  <h2>Résultat du jeu</h2>
  <div class="d-flex align-items-center">
    <ul class="list-group list-group-horizontal gap-2 list-unstyled me-3">
      <% @grid.each do |letter| %>
        <li class="bg-primary text-white rounded fw-bold fs-4 d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px;">
          <%= letter %>
        </li>
      <% end %>
    </ul>
  </div>
  <hr>
  <% case @result[:status] %>
  <% when :not_in_grid %>
    <div class="alert alert-danger" role="alert">
      Désolé, mais « <strong><%= @word %></strong> » n'est pas dans la grille.
    </div>
  <% when :not_english %>
    <div class="alert alert-warning" role="alert">
      Désolé, mais « <strong><%= @word %></strong> » n'est pas un mot anglais.
    </div>
  <% when :success %>
    <div class="alert alert-success" role="alert">
      <h4>Bien joué !</h4>
      <p>« <strong><%= @word %></strong> » rapporte <strong><%= @result[:score] %></strong> points.</p>
      <hr>
      <p>Temps : <%= @result[:time] %> secondes</p>
    </div>
  <% end %>
  <div class="text-center">
    <p>Score total : <strong><%= session[:total_score] || 0 %></strong> points</p>
    <%= link_to "Rejouer", new_path, class: "btn btn-primary px-4" %>
  </div>
</div>
